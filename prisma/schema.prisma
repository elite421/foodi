generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  name      String    @default("Admin")
  createdAt DateTime  @default(now()) @map("created_at")
  sessions  Session[]

  @@map("admins")
}

model Session {
  id        String   @id @default(uuid())
  adminId   Int?     @map("admin_id")
  userId    String?  @map("user_id")
  expiresAt DateTime @map("expires_at")
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id        String    @id
  name      String?
  email     String?   @unique
  phone     String?   @unique
  createdAt DateTime  @default(now()) @map("created_at")
  addresses Address[]
  orders    Order[]
  sessions  Session[]

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid())
  phone     String   @unique
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otps")
}

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  label     String   @default("Home")
  street    String
  city      String
  state     String
  zip       String
  lat       Float?
  lng       Float?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@map("addresses")
}

model Category {
  id        String     @id
  name      String
  icon      String     @default("")
  image     String     @default("")
  sortOrder Int        @default(0) @map("sort_order")
  items     MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          String      @id @default(uuid())
  categoryId  String      @map("category_id")
  brandId     String?     @map("brand_id")
  name        String
  description String      @default("")
  image       String      @default("")
  price       Float       @default(0)
  isVeg       Boolean     @default(true) @map("is_veg")
  isAvailable Boolean     @default(true) @map("is_available")
  sortOrder   Int         @default(0) @map("sort_order")
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand       Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  partyItems  PartyItem[]

  @@map("menu_items")
}

model Brand {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  image       String     @default("")
  description String     @default("")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  menuItems   MenuItem[]

  @@map("brands")
}

model Coupon {
  id             String   @id @default(uuid())
  code           String   @unique
  discountType   String   @default("PERCENTAGE") // PERCENTAGE or FLAT
  discountValue  Float
  minOrderValue  Float    @default(0) @map("min_order_value")
  maxDiscount    Float?   @map("max_discount")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("coupons")
}

model Order {
  id               String      @id // 7 chars alphanumeric
  userId           String      @map("user_id")
  addressId        String?     @map("address_id")
  status           String      @default("PENDING") // PENDING, ACCEPTED, PREPARING, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentMethod    String      @default("COD") @map("payment_method") // COD, ONLINE
  paymentStatus    String      @default("PENDING") @map("payment_status") // PENDING, COMPLETED, FAILED, REFUNDED
  paymentId        String?     @map("payment_id")
  razorpayOrderId  String?     @map("razorpay_order_id")
  paidAt           DateTime?   @map("paid_at")
  refundId         String?     @map("refund_id")
  refundStatus     String?     @map("refund_status")
  refundAmount     Float?      @map("refund_amount")
  paymentError     String?     @map("payment_error")
  subtotal         Float
  tax              Float
  deliveryFee      Float       @map("delivery_fee")
  discount         Float       @default(0)
  total            Float
  couponCode       String?     @map("coupon_code")
  specialInstructions String?  @map("special_instructions")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  address          Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  menuItemId    String   @map("menu_item_id")
  quantity      Int
  priceAtTime   Float    @map("price_at_time")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Party {
  id          String       @id @default(uuid())
  name        String
  description String       @default("")
  image       String       @default("")
  date        DateTime?
  venue       String       @default("")
  maxGuests   Int          @default(50) @map("max_guests")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  partyItems  PartyItem[]

  @@map("parties")
}

model PartyItem {
  id            String     @id @default(uuid())
  partyId       String     @map("party_id")
  menuItemId    String     @map("menu_item_id")
  quantity      Int        @default(1)
  price         Float      @default(0)
  party         Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  menuItem      MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("party_items")
}

model Settings {
  id             Int     @id @default(1)
  siteName       String  @default("FooodieClub") @map("site_name")
  tagline        String  @default("Your favorite restaurant, online")
  domain         String  @default("fooodieclub.com")
  phone          String  @default("1800-123-4567")
  email          String  @default("support@fooodieclub.com")
  address        String  @default("123 Food Street, New Delhi, India")
  facebook       String  @default("https://facebook.com/fooodieclub")
  instagram      String  @default("https://instagram.com/fooodieclub")
  twitter        String  @default("https://twitter.com/fooodieclub")
  primaryColor   String  @default("#4338ca") @map("primary_color")
  secondaryColor String  @default("#f59e0b") @map("secondary_color")
  
  // Single Restaurant specific settings
  restaurantLat  Float   @default(28.6139) @map("restaurant_lat")
  restaurantLng  Float   @default(77.2090) @map("restaurant_lng")
  deliveryRadius Float   @default(10.0) @map("delivery_radius") // in km
  taxPercentage  Float   @default(5.0) @map("tax_percentage")
  baseDeliveryFee Float  @default(40.0) @map("base_delivery_fee")
  
  // Free delivery threshold
  freeDeliveryThreshold Float @default(500.0) @map("free_delivery_threshold")
  
  // Order minimums
  minOrderAmount Float @default(100.0) @map("min_order_amount")
  
  razorpayKeyId   String @default("") @map("razorpay_key_id")
  razorpayKeySecret String @default("") @map("razorpay_key_secret")
  razorpayWebhookSecret String @default("") @map("razorpay_webhook_secret")
  msg91AuthKey String @default("") @map("msg91_auth_key")
  msg91OtpTemplateId String @default("") @map("msg91_otp_template_id")
  msg91SenderId String @default("FDCOTP") @map("msg91_sender_id")

  // Relations
  deliveryFeeRules DeliveryFeeRule[]
  additionalFees   AdditionalFee[]

  @@map("settings")
}

// Delivery Fee Rules - Multiple rules based on conditions
model DeliveryFeeRule {
  id              String   @id @default(uuid())
  settingsId      Int      @default(1) @map("settings_id")
  name            String   @default("Standard Delivery")
  description     String   @default("")
  
  // Rule conditions
  conditionType   String   @default("ALWAYS") @map("condition_type") // ALWAYS, MIN_ORDER, MAX_ORDER, DISTANCE, TIME_RANGE, DAY_OF_WEEK
  minOrderValue   Float?   @map("min_order_value")
  maxOrderValue   Float?   @map("max_order_value")
  minDistance     Float?   @map("min_distance") // in km
  maxDistance     Float?   @map("max_distance") // in km
  startTime       String?  @map("start_time") // HH:MM format
  endTime         String?  @map("end_time") // HH:MM format
  daysOfWeek      String   @default("[]") @map("days_of_week") // JSON array [0,1,2,3,4,5,6] for Sun-Sat
  
  // Fee calculation
  feeType         String   @default("FLAT") @map("fee_type") // FLAT, PERCENTAGE, PER_KM, TIERED
  feeValue        Float    @default(40.0) @map("fee_value")
  feePercentage   Float?   @map("fee_percentage") // if PERCENTAGE type
  perKmRate       Float?   @map("per_km_rate") // if PER_KM type
  maxFee          Float?   @map("max_fee") // cap for percentage fees
  
  // Rule priority and status
  priority        Int      @default(0) // Higher number = higher priority
  isActive        Boolean  @default(true) @map("is_active")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  settings        Settings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  
  @@map("delivery_fee_rules")
}

// Additional Fees - Multiple fees that can be added to orders
model AdditionalFee {
  id              String   @id @default(uuid())
  settingsId      Int      @default(1) @map("settings_id")
  name            String   @default("Service Fee")
  description     String   @default("")
  
  // When to apply
  applyTo         String   @default("ALL_ORDERS") @map("apply_to") // ALL_ORDERS, ONLINE_PAYMENT, COD, SPECIFIC_ITEMS, MIN_ORDER
  minOrderValue   Float?   @map("min_order_value")
  maxOrderValue   Float?   @map("max_order_value")
  
  // Fee calculation
  feeType         String   @default("FLAT") @map("fee_type") // FLAT, PERCENTAGE, PER_ITEM
  feeValue        Float    @default(0.0) @map("fee_value")
  feePercentage   Float?   @map("fee_percentage")
  maxFee          Float?   @map("max_fee")
  minFee          Float?   @map("min_fee")
  
  // Display options
  isTaxable       Boolean  @default(false) @map("is_taxable") // Whether this fee is taxable
  showInBreakdown Boolean  @default(true) @map("show_in_breakdown")
  
  // Rule priority and status
  priority        Int      @default(0)
  isActive        Boolean  @default(false) @map("is_active") // Default inactive, admin must enable
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  settings        Settings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  
  @@map("additional_fees")
}

model Hero {
  id                Int    @id @default(1)
  title             String @default("Welcome to FooodieClub!")
  subtitle          String @default("Order from our exclusive menu.")
  promoText         String @default("Use code: FC50 to get FLAT 50% OFF on your 1st order.") @map("promo_text")
  searchPlaceholder String @default("What are you craving today?") @map("search_placeholder")
  statsRating       String @default("5.0 rated") @map("stats_rating")
  statsDownloads    String @default("10K+ Happy Customers") @map("stats_downloads")
  statsCities       String @default("Fast Delivery in city") @map("stats_cities")
  bannerTitle       String @default("BUY 1 GET 1") @map("banner_title")
  bannerHighlight   String @default("FREE") @map("banner_highlight")
  bannerSubtitle    String @default("ALL DAY, EVERYDAY") @map("banner_subtitle")

  @@map("hero")
}

// We will keep Offers & Collections & Pages mostly as-is, just adapt them for single restaurant concept.
model Offer {
  id         String  @id
  title      String  @default("")
  subtitle   String  @default("")
  image      String  @default("")
  bgColor    String  @default("#4338ca") @map("bg_color")
  active     Boolean @default(true)

  @@map("offers")
}

model Collection {
  id          String @id
  title       String @default("")
  image       String @default("")
  link        String @default("/menu")
  description String @default("")
  menuItemIds String @default("[]") @map("menu_item_ids") // JSON array of menu item IDs

  @@map("collections")
}

model Elite {
  id           Int    @id @default(1)
  title        String @default("ELITE")
  tagline      String @default("Claim your Elite benefits")
  freeDelivery String @default("above ₹199") @map("free_delivery")
  freeDishes   String @default("above ₹449") @map("free_dishes")

  @@map("elite")
}

model EliteItem {
  id        String @id
  label     String @default("")
  image     String @default("")
  sortOrder Int    @default(0) @map("sort_order")

  @@map("elite_items")
}

model Page {
  id              String   @id
  title           String
  slug            String   @unique
  content         String   @default("")
  metaDescription String   @default("") @map("meta_description")
  published       Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("pages")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String   @default("API Key")
  key         String   @unique
  permissions String[] @default(["read"])
  isActive    Boolean  @default(true)
  lastUsed    DateTime? @map("last_used")
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("api_keys")
}
